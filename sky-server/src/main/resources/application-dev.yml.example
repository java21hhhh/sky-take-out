# ---------------------------------------------------------------------------
# application-dev.yml 模板
#
# 真实的 application-dev.yml 已被 .gitignore 排除，不会进入 Git 仓库
# （它含有 MySQL 密码、阿里云 OSS AccessKey、微信小程序 AppSecret）。
#
# 换新机器 / 重新克隆仓库之后，程序启动会因为缺这个文件而失败，请：
#
#   1. 把本文件复制成同目录下的 application-dev.yml
#        cp application-dev.yml.example application-dev.yml
#   2. 把下面所有 <...> 占位符替换成你自己的真实值
#
# 各项值的来源：
#   sky.datasource.*   本地 MySQL（database 需先执行项目里的建库 SQL 脚本）
#   sky.redis.*        本地 Redis（未设 requirepass 就不需要 password）
#   sky.alioss.*       阿里云控制台 → AccessKey 管理
#   sky.wechat.appid   微信公众平台 → 开发管理 → 开发设置 → 小程序 AppID
#   sky.wechat.secret  同上 → AppSecret
#                      留空会导致微信登录报 errcode=40125 invalid secret
# ---------------------------------------------------------------------------
sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: <你的 MySQL 密码>
  redis:
    host: localhost
    port: 6379
  alioss:
    endpoint: oss-cn-beijing.aliyuncs.com
    bucketName: sky-take-out-hxr
    accessKeyId: <你的阿里云 AccessKeyId>
    accessKeySecret: <你的阿里云 AccessKeySecret>
  wechat:
    # C 端小程序 AppID（需与本项目小程序 project.config.json 中的 appid 一致）
    appid: <你的小程序 AppID>
    # 小程序 AppSecret：微信公众平台 → 开发管理 → 开发设置 → AppSecret
    secret: <你的小程序 AppSecret>
